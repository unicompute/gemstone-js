{
  "name": "gemstone-js",
  "version": "0.1.0-alpha.0",
  "description": "Async TypeScript client for GemStone/S via GCI.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/mock-runtime.ts",
      "import": "./src/testing/mock-runtime.ts"
    }
  },
  "files": [
    "src",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "codegen": "node ./src/codegen.ts"
  },
  "optionalDependencies": {
    "@gemstone-js/native": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "gemstone",
    "smalltalk",
    "database",
    "gci",
    "typescript"
  ]
}
