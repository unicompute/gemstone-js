{
  "name": "gemstone-js-workbench",
  "displayName": "gemstone-js Workbench",
  "description": "VS Code wrapper for the gemstone-js Explorer, code runner, diagnostics, and debugger.",
  "version": "0.1.0",
  "publisher": "unicompute",
  "icon": "media/icon_purple.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unicompute/gemstone-js.git",
    "directory": "vscode-gemstone-js-workbench"
  },
  "keywords": [
    "gemstone",
    "smalltalk",
    "javascript",
    "typescript",
    "database",
    "debugger"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onView:gemstoneJs.connectionView",
    "onView:gemstoneJs.rootsView",
    "onView:gemstoneJs.globalsView",
    "onView:gemstoneJs.classesView",
    "onCommand:gemstoneJs.openExplorer",
    "onCommand:gemstoneJs.openExplorerExternal",
    "onCommand:gemstoneJs.startExplorer",
    "onCommand:gemstoneJs.stopExplorer",
    "onCommand:gemstoneJs.restartExplorer",
    "onCommand:gemstoneJs.doctor",
    "onCommand:gemstoneJs.evaluateSelection",
    "onCommand:gemstoneJs.debugSelection",
    "onCommand:gemstoneJs.runFile",
    "onCommand:gemstoneJs.setPassword",
    "onCommand:gemstoneJs.clearPassword",
    "onCommand:gemstoneJs.refreshViews",
    "onCommand:gemstoneJs.refreshConnection",
    "onCommand:gemstoneJs.refreshRoots",
    "onCommand:gemstoneJs.refreshGlobals",
    "onCommand:gemstoneJs.refreshClasses",
    "onCommand:gemstoneJs.filterRoots",
    "onCommand:gemstoneJs.filterGlobals",
    "onCommand:gemstoneJs.filterClasses",
    "onCommand:gemstoneJs.clearRootsFilter",
    "onCommand:gemstoneJs.clearGlobalsFilter",
    "onCommand:gemstoneJs.clearClassesFilter",
    "onCommand:gemstoneJs.openClassBrowser",
    "onDebugResolve:gemstone-js"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "smalltalk",
        "aliases": [
          "Smalltalk",
          "GemStone Smalltalk"
        ],
        "extensions": [
          ".st",
          ".gs",
          ".topaz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "smalltalk",
        "scopeName": "source.smalltalk.gemstone",
        "path": "./syntaxes/smalltalk.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "gemstone-js Workbench",
      "properties": {
        "gemstoneJs.repoPath": {
          "type": "string",
          "default": "",
          "description": "Local gemstone-js repository path. Leave empty to use the parent of this extension when developing in the gemstone-js checkout, or the current workspace folder."
        },
        "gemstoneJs.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to launch the gemstone-js Explorer."
        },
        "gemstoneJs.explorerScriptPath": {
          "type": "string",
          "default": "",
          "description": "Path to examples/explorer.ts. Leave empty to resolve it from gemstoneJs.repoPath."
        },
        "gemstoneJs.explorerHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host used when launching the gemstone-js Explorer."
        },
        "gemstoneJs.explorerPort": {
          "type": "number",
          "default": 3117,
          "description": "Port used when launching the gemstone-js Explorer."
        },
        "gemstoneJs.openMode": {
          "type": "string",
          "enum": [
            "webview",
            "external"
          ],
          "default": "webview",
          "description": "Where GemStone: Open Explorer opens the running Explorer."
        },
        "gemstoneJs.user": {
          "type": "string",
          "default": "DataCurator",
          "description": "GemStone user name. Exported as GS_USER and GS_USERNAME."
        },
        "gemstoneJs.password": {
          "type": "string",
          "default": "",
          "description": "Legacy GemStone password fallback. Prefer GemStone: Set Password, which stores the password in VS Code SecretStorage."
        },
        "gemstoneJs.stone": {
          "type": "string",
          "default": "gs64stone",
          "description": "GemStone stone name. Exported as GS_STONE and GS_STONE_NAME."
        },
        "gemstoneJs.netldiHost": {
          "type": "string",
          "default": "localhost",
          "description": "NetLDI host. Exported as GS_NETLDI_HOST and GS_HOST."
        },
        "gemstoneJs.netldiNameOrPort": {
          "type": "string",
          "default": "netldi",
          "description": "NetLDI name or port. Exported as GS_NETLDI_NAME_OR_PORT and GS_NETLDI."
        },
        "gemstoneJs.gemService": {
          "type": "string",
          "default": "gemnetobject",
          "description": "Gem service. Exported as GS_GEM_SERVICE."
        },
        "gemstoneJs.nativeSessionWorker": {
          "type": "boolean",
          "default": false,
          "description": "Enable GS_NATIVE_SESSION_WORKER for Explorer sessions."
        },
        "gemstoneJs.extraEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional environment variables passed to the Explorer process."
        },
        "gemstoneJs.defaultReturnKind": {
          "type": "string",
          "enum": [
            "inspect",
            "value",
            "oop"
          ],
          "default": "inspect",
          "description": "Default return kind for GemStone: Evaluate Selection and debug launch configurations."
        }
      }
    },
    "commands": [
      {
        "command": "gemstoneJs.refreshViews",
        "title": "GemStone: Refresh Views",
        "icon": "$(refresh)"
      },
      {
        "command": "gemstoneJs.refreshConnection",
        "title": "GemStone: Refresh Connection",
        "icon": "$(refresh)"
      },
      {
        "command": "gemstoneJs.refreshRoots",
        "title": "GemStone: Refresh Roots",
        "icon": "$(refresh)"
      },
      {
        "command": "gemstoneJs.refreshGlobals",
        "title": "GemStone: Refresh Globals",
        "icon": "$(refresh)"
      },
      {
        "command": "gemstoneJs.refreshClasses",
        "title": "GemStone: Refresh Classes",
        "icon": "$(refresh)"
      },
      {
        "command": "gemstoneJs.filterRoots",
        "title": "GemStone: Filter Roots",
        "icon": "$(filter)"
      },
      {
        "command": "gemstoneJs.filterGlobals",
        "title": "GemStone: Filter Globals",
        "icon": "$(filter)"
      },
      {
        "command": "gemstoneJs.filterClasses",
        "title": "GemStone: Filter Classes",
        "icon": "$(filter)"
      },
      {
        "command": "gemstoneJs.clearRootsFilter",
        "title": "GemStone: Clear Roots Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "gemstoneJs.clearGlobalsFilter",
        "title": "GemStone: Clear Globals Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "gemstoneJs.clearClassesFilter",
        "title": "GemStone: Clear Classes Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "gemstoneJs.openExplorer",
        "title": "GemStone: Open Explorer"
      },
      {
        "command": "gemstoneJs.openExplorerExternal",
        "title": "GemStone: Open Explorer in Browser"
      },
      {
        "command": "gemstoneJs.openClassBrowser",
        "title": "GemStone: Open Class Browser"
      },
      {
        "command": "gemstoneJs.startExplorer",
        "title": "GemStone: Start Explorer"
      },
      {
        "command": "gemstoneJs.stopExplorer",
        "title": "GemStone: Stop Explorer"
      },
      {
        "command": "gemstoneJs.restartExplorer",
        "title": "GemStone: Restart Explorer"
      },
      {
        "command": "gemstoneJs.doctor",
        "title": "GemStone: Doctor"
      },
      {
        "command": "gemstoneJs.evaluateSelection",
        "title": "GemStone: Evaluate Selection",
        "icon": "$(run)"
      },
      {
        "command": "gemstoneJs.debugSelection",
        "title": "GemStone: Debug Selection",
        "icon": "$(debug-alt)"
      },
      {
        "command": "gemstoneJs.runFile",
        "title": "GemStone: Run File"
      },
      {
        "command": "gemstoneJs.setPassword",
        "title": "GemStone: Set Password"
      },
      {
        "command": "gemstoneJs.clearPassword",
        "title": "GemStone: Clear Password"
      }
    ],
    "debuggers": [
      {
        "type": "gemstone-js",
        "label": "GemStone JS",
        "languages": [
          "smalltalk"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "source": {
                "type": "string",
                "description": "Smalltalk source to debug. Leave empty to use the active editor selection or document text.",
                "default": ""
              },
              "returnKind": {
                "type": "string",
                "enum": [
                  "inspect",
                  "value",
                  "oop"
                ],
                "default": "inspect"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "gemstone-js",
            "request": "launch",
            "name": "Debug GemStone Selection",
            "source": "",
            "returnKind": "inspect"
          }
        ],
        "configurationSnippets": [
          {
            "label": "GemStone: Debug Selection",
            "description": "Debug the active editor selection, or the whole document when no text is selected.",
            "body": {
              "type": "gemstone-js",
              "request": "launch",
              "name": "Debug GemStone Selection",
              "source": "",
              "returnKind": "inspect"
            }
          },
          {
            "label": "GemStone: Debug Source",
            "description": "Debug an inline Smalltalk source expression through the gemstone-js Explorer.",
            "body": {
              "type": "gemstone-js",
              "request": "launch",
              "name": "Debug GemStone Source",
              "source": "1/0",
              "returnKind": "inspect"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemstoneJs",
          "title": "GemStone JS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gemstoneJs": [
        {
          "id": "gemstoneJs.connectionView",
          "name": "Connection"
        },
        {
          "id": "gemstoneJs.rootsView",
          "name": "Roots"
        },
        {
          "id": "gemstoneJs.globalsView",
          "name": "Globals"
        },
        {
          "id": "gemstoneJs.classesView",
          "name": "Classes"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gemstoneJs.refreshConnection",
          "when": "view == gemstoneJs.connectionView",
          "group": "navigation"
        },
        {
          "command": "gemstoneJs.refreshRoots",
          "when": "view == gemstoneJs.rootsView",
          "group": "navigation"
        },
        {
          "command": "gemstoneJs.filterRoots",
          "when": "view == gemstoneJs.rootsView",
          "group": "navigation@2"
        },
        {
          "command": "gemstoneJs.refreshGlobals",
          "when": "view == gemstoneJs.globalsView",
          "group": "navigation"
        },
        {
          "command": "gemstoneJs.filterGlobals",
          "when": "view == gemstoneJs.globalsView",
          "group": "navigation@2"
        },
        {
          "command": "gemstoneJs.refreshClasses",
          "when": "view == gemstoneJs.classesView",
          "group": "navigation"
        },
        {
          "command": "gemstoneJs.filterClasses",
          "when": "view == gemstoneJs.classesView",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gemstoneJs.evaluateSelection",
          "group": "navigation@1"
        },
        {
          "command": "gemstoneJs.debugSelection",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "gemstoneJs.evaluateSelection",
          "when": "editorTextFocus",
          "group": "navigation@1"
        },
        {
          "command": "gemstoneJs.debugSelection",
          "when": "editorTextFocus",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "package:ci": "npx @vscode/vsce package --no-dependencies",
    "package:dry-run": "npx @vscode/vsce package --no-dependencies --out gemstone-js-workbench.vsix",
    "test:host": "node scripts/run-extension-host-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:package": "node scripts/release.mjs --package-only",
    "release:publish": "node scripts/release.mjs --publish",
    "verify": "npm run release:check && npm run check && npm run test:smoke && npm run package:ci && npm run verify:vsix",
    "verify:vsix": "node scripts/check-vsix.mjs",
    "verify:vsix:checksum": "node scripts/check-vsix.mjs --checksum"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1"
  }
}
