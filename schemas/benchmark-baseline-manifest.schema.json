{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicompute.github.io/gemstone-js/schemas/benchmark-baseline-manifest.schema.json",
  "title": "gemstone-js benchmark baseline manifest",
  "type": "object",
  "required": ["schema_version", "baselines"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "baselines": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
