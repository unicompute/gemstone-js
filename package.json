{
  "name": "gemstone-js",
  "version": "0.1.0-alpha.0",
  "description": "Async TypeScript client for GemStone/S via GCI.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/unicompute/gemstone-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unicompute/gemstone-js.git"
  },
  "bugs": {
    "url": "https://github.com/unicompute/gemstone-js/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/mock-runtime.ts",
      "import": "./src/testing/mock-runtime.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "import": "./src/adapters/index.ts"
    },
    "./adapters/express": {
      "types": "./src/adapters/express.ts",
      "import": "./src/adapters/express.ts"
    },
    "./adapters/fastify": {
      "types": "./src/adapters/fastify.ts",
      "import": "./src/adapters/fastify.ts"
    },
    "./adapters/hono": {
      "types": "./src/adapters/hono.ts",
      "import": "./src/adapters/hono.ts"
    },
    "./schemas/codegen-manifest.schema.json": "./schemas/codegen-manifest.schema.json",
    "./schemas/benchmark-report.schema.json": "./schemas/benchmark-report.schema.json",
    "./schemas/benchmark-baseline-manifest.schema.json": "./schemas/benchmark-baseline-manifest.schema.json"
  },
  "bin": {
    "gemstone-js-benchmark-baselines": "./scripts/benchmark-baselines.mjs",
    "gemstone-js-benchmark-compare": "./scripts/benchmark-compare.mjs",
    "gemstone-js-benchmark-register": "./scripts/benchmark-register.mjs",
    "gemstone-js-benchmark-validate": "./scripts/benchmark-validate.mjs",
    "gemstone-js-benchmarks": "./scripts/benchmarks.mjs",
    "gemstone-js-bootstrap": "./scripts/bootstrap.mjs",
    "gemstone-js-inspect": "./scripts/inspect.mjs",
    "gemstone-js-migrations": "./scripts/migrations.mjs"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "schemas",
    "scripts/benchmark-baselines.mjs",
    "scripts/benchmark-compare.mjs",
    "scripts/benchmark-register.mjs",
    "scripts/benchmark-validate.mjs",
    "scripts/benchmarks.mjs",
    "scripts/bootstrap.mjs",
    "scripts/check-checksums.mjs",
    "scripts/check-package.mjs",
    "scripts/check-public-surface.mjs",
    "scripts/codegen.mjs",
    "scripts/inspect.mjs",
    "scripts/migrations.mjs",
    "scripts/public-surface.expected.json",
    "scripts/scan-codegen.mjs",
    "scripts/verify-checksums.mjs",
    "scripts/write-checksums.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "benchmark:baselines": "node scripts/benchmark-baselines.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "benchmark:register": "node scripts/benchmark-register.mjs",
    "benchmark:validate": "node scripts/benchmark-validate.mjs",
    "benchmarks": "node scripts/benchmarks.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check examples/codegen.manifest.json examples/codegen.generated.ts",
    "codegen:scan": "node scripts/scan-codegen.mjs",
    "codegen:scan:check": "node scripts/scan-codegen.mjs --module --check --out examples/booking.decorators.generated.ts examples/booking.decorators.ts",
    "inspect": "node scripts/inspect.mjs",
    "migrations": "node scripts/migrations.mjs",
    "public-surface:check": "node scripts/check-public-surface.mjs",
    "public-surface:write": "node scripts/check-public-surface.mjs --write",
    "checksum:check": "node scripts/check-checksums.mjs",
    "checksum:verify": "node scripts/verify-checksums.mjs",
    "test:live": "GS_RUN_LIVE=1 node --test tests/live.test.ts",
    "verify": "npm run typecheck && npm run codegen:check && npm run codegen:scan:check && npm run public-surface:check && npm test && npm run checksum:check && npm run pack:check"
  },
  "optionalDependencies": {
    "@gemstone-js/native": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "gemstone",
    "smalltalk",
    "database",
    "gci",
    "typescript"
  ]
}
